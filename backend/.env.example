# ---- BridgeBot AI backend --------------------------------------------------
ENVIRONMENT=development
# Local zero-cost default (SQLite file). For Supabase use the *Session pooler*
# connection string (IPv4, works on Render/Koyeb):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./bridgebot.db
AUTO_CREATE_TABLES=true

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_dev_only_secret_please_override_32+chars
JWT_EXPIRE_MINUTES=10080

# Comma-separated frontend origins, e.g. https://bridgebot.vercel.app
CORS_ORIGINS=*

# Free LLM via OpenRouter (https://openrouter.ai/keys). Leave empty to use the
# deterministic template compiler (still fully functional, $0).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free

SIGNUP_TOKEN_GRANT=10000
MIN_TRAINING_COST=250
HEARTBEAT_TIMEOUT_S=90
DEFAULT_TASK_TIMEOUT_S=120
FRONTEND_DIR=../frontend/out

# ---- Admin (the ONLY admin account; case-insensitive) ----
ADMIN_EMAIL=Abaudii12@gmail.com
# Optional: auto-create the admin account at startup with this password
ADMIN_PASSWORD=

# ---- Billing (manual verification today; stripe/paddle later) ----
PAYMENT_PROVIDER=manual
PAYPAL_ME_URL=https://paypal.me/BunnyOnMoney
PAYPAL_ACCOUNT_NAME=Abdul Rehman Chohan
SUPPORT_WHATSAPP=966567009846
BILLING_PERIOD_DAYS=30
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET= / PADDLE_API_KEY= / PADDLE_WEBHOOK_SECRET=

# ---- Webhooks ----
# Private/loopback targets are blocked when ENVIRONMENT=production (SSRF guard)
WEBHOOK_ALLOW_PRIVATE=
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_S=30
PUBLIC_BASE_URL=
